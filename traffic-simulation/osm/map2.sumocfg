<?xml version="1.0" encoding="UTF-8"?>
<!-- map2.sumocfg - Mô phỏng bản đồ thực tế từ OSM (map2.osm) -->
<configuration>
    <input>
        <net-file value="map2.net.xml"/>
        <route-files value="map2.rou.xml"/>
    </input>
    <output>
        <tripinfo-output value="../output/tripinfo_map2.xml"/>
    </output>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>
    <processing>
        <time-to-teleport value="300"/>
        <ignore-route-errors value="true"/>
    </processing>
    <report>
        <no-warnings value="true"/>
        <no-step-log value="true"/>
    </report>
</configuration>
