<?xml version="1.0" encoding="UTF-8"?>
<!--
    edges.edg.xml – Định nghĩa các đoạn đường
    Tổng cộng 8 cạnh (edges) biểu diễn 4 hướng lưu thông hai chiều:

    Hướng Bắc–Nam:  N2C (250m), C2N (250m)
    Hướng Nam–Bắc:  S2C (250m), C2S (250m)
    Hướng Đông–Tây: E2C (250m), C2E (250m)
    Hướng Tây–Đông: W2C (250m), C2W (250m)

    Thông số:
    - numLanes: 2 làn xe
    - speed: 13.89 m/s ≈ 50 km/h
    - priority: 1
-->
<edges>
    <!-- Hướng Bắc → Trung tâm -->
    <edge id="N2C" from="N" to="C" numLanes="2" speed="13.89" priority="1"/>
    <!-- Hướng Trung tâm → Bắc -->
    <edge id="C2N" from="C" to="N" numLanes="2" speed="13.89" priority="1"/>

    <!-- Hướng Nam → Trung tâm -->
    <edge id="S2C" from="S" to="C" numLanes="2" speed="13.89" priority="1"/>
    <!-- Hướng Trung tâm → Nam -->
    <edge id="C2S" from="C" to="S" numLanes="2" speed="13.89" priority="1"/>

    <!-- Hướng Đông → Trung tâm -->
    <edge id="E2C" from="E" to="C" numLanes="2" speed="13.89" priority="1"/>
    <!-- Hướng Trung tâm → Đông -->
    <edge id="C2E" from="C" to="E" numLanes="2" speed="13.89" priority="1"/>

    <!-- Hướng Tây → Trung tâm -->
    <edge id="W2C" from="W" to="C" numLanes="2" speed="13.89" priority="1"/>
    <!-- Hướng Trung tâm → Tây -->
    <edge id="C2W" from="C" to="W" numLanes="2" speed="13.89" priority="1"/>
</edges>
