<?xml version="1.0" encoding="UTF-8"?>
<!--
    routes_TH6.rou.xml – Thí nghiệm 6: Lưu lượng 1200 xe/h mỗi hướng
    Kịch bản ùn tắc nghiêm trọng nhất – ngưỡng bão hòa.
-->
<routes>
    <vType id="car" vClass="passenger" length="4.5" minGap="2.5"
           maxSpeed="13.89" accel="2.6" decel="4.5" sigma="0.5"
           color="0.5,0,0"/>

    <route id="route_NS" edges="N2C C2S"/>
    <route id="route_SN" edges="S2C C2N"/>
    <route id="route_EW" edges="E2C C2W"/>
    <route id="route_WE" edges="W2C C2E"/>

    <flow id="flow_NS_TH6" type="car" route="route_NS"
          begin="0" end="3600" vehsPerHour="1200" departLane="best" departSpeed="max"/>

    <flow id="flow_SN_TH6" type="car" route="route_SN"
          begin="0" end="3600" vehsPerHour="1200" departLane="best" departSpeed="max"/>

    <flow id="flow_EW_TH6" type="car" route="route_EW"
          begin="0" end="3600" vehsPerHour="1200" departLane="best" departSpeed="max"/>

    <flow id="flow_WE_TH6" type="car" route="route_WE"
          begin="0" end="3600" vehsPerHour="1200" departLane="best" departSpeed="max"/>
</routes>
