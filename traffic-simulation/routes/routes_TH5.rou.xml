<?xml version="1.0" encoding="UTF-8"?>
<!--
    routes_TH5.rou.xml – Thí nghiệm 5: Lưu lượng 1000 xe/h mỗi hướng
    Kịch bản có ùn tắc rõ rệt.
-->
<routes>
    <vType id="car" vClass="passenger" length="4.5" minGap="2.5"
           maxSpeed="13.89" accel="2.6" decel="4.5" sigma="0.5"
           color="1,0,0.5"/>

    <route id="route_NS" edges="N2C C2S"/>
    <route id="route_SN" edges="S2C C2N"/>
    <route id="route_EW" edges="E2C C2W"/>
    <route id="route_WE" edges="W2C C2E"/>

    <flow id="flow_NS_TH5" type="car" route="route_NS"
          begin="0" end="3600" vehsPerHour="1000" departLane="best" departSpeed="max"/>

    <flow id="flow_SN_TH5" type="car" route="route_SN"
          begin="0" end="3600" vehsPerHour="1000" departLane="best" departSpeed="max"/>

    <flow id="flow_EW_TH5" type="car" route="route_EW"
          begin="0" end="3600" vehsPerHour="1000" departLane="best" departSpeed="max"/>

    <flow id="flow_WE_TH5" type="car" route="route_WE"
          begin="0" end="3600" vehsPerHour="1000" departLane="best" departSpeed="max"/>
</routes>
