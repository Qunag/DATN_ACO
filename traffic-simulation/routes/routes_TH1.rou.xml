<?xml version="1.0" encoding="UTF-8"?>
<!--
    routes_TH1.rou.xml – Thí nghiệm 1: Lưu lượng 200 xe/h mỗi hướng
    =====================================================================
    4 luồng xe (flows) tương ứng 4 hướng lưu thông:
      - North → South  (N → C → S)
      - South → North  (S → C → N)
      - East  → West   (E → C → W)
      - West  → East   (W → C → E)

    Công thức chuyển đổi lưu lượng → khoảng thời gian giữa 2 xe:
      200 xe/h = 200/3600 ≈ 0.0556 xe/s → vehsPerHour="200"
-->
<routes>
    <!-- Định nghĩa loại phương tiện: xe con -->
    <vType id="car" vClass="passenger" length="4.5" minGap="2.5"
           maxSpeed="13.89" accel="2.6" decel="4.5" sigma="0.5"
           color="1,0,0"/>

    <!-- Định nghĩa các tuyến đường -->
    <route id="route_NS" edges="N2C C2S"/>
    <route id="route_SN" edges="S2C C2N"/>
    <route id="route_EW" edges="E2C C2W"/>
    <route id="route_WE" edges="W2C C2E"/>

    <!--
        Flow: sinh phương tiện theo lưu lượng liên tục
        begin="0"   : bắt đầu từ giây 0
        end="3600"  : kết thúc sau 1 giờ mô phỏng
        vehsPerHour : lưu lượng mỗi giờ
    -->
    <flow id="flow_NS_TH1" type="car" route="route_NS"
          begin="0" end="3600" vehsPerHour="200" departLane="best" departSpeed="max"/>

    <flow id="flow_SN_TH1" type="car" route="route_SN"
          begin="0" end="3600" vehsPerHour="200" departLane="best" departSpeed="max"/>

    <flow id="flow_EW_TH1" type="car" route="route_EW"
          begin="0" end="3600" vehsPerHour="200" departLane="best" departSpeed="max"/>

    <flow id="flow_WE_TH1" type="car" route="route_WE"
          begin="0" end="3600" vehsPerHour="200" departLane="best" departSpeed="max"/>
</routes>
